# HAVEN backend — every integration is optional; the demo runs with none of these set.

# Event log location (SQLite). Deploy: keep on a persistent volume.
HAVEN_DB=data/haven.db
# Comma-separated CORS origins for the deployed frontend.
HAVEN_CORS_ORIGINS=*
# If set, the ESP32 must send this in X-Haven-Token (manual / UI readings are unaffected).
HAVEN_SENSOR_TOKEN=

# Claude: fallback parser for spoken rules the regex misses, and spoken-summary polish.
ANTHROPIC_API_KEY=
HAVEN_LLM_MODEL=claude-opus-5-5

# Cartesia: voice for the plumber call and the manager alert (POST /api/speak).
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-2

# Tiger Data (TimescaleDB): live sensor readings time-series (GET /api/sensor/{id}/history).
TIGER_DATABASE_URL=

# Fetch.ai: the residents' personal agents run as uAgents inside the backend (no key needed).
# AGENTVERSE_API_KEY (agentverse.ai -> API keys) also registers them on Agentverse via mailbox.
HAVEN_FETCH=1
HAVEN_FETCH_PORT=8010
AGENTVERSE_API_KEY=

# Twilio: the real outbound plumber call and a demo text on approval (console.twilio.com).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
HAVEN_PLUMBER_NUMBER=
HAVEN_PLUMBER_NUMBER_2=
HAVEN_PLUMBER_NUMBER_3=
HAVEN_SMS_TO=
# Public URL of this backend (a tunnel or the deployed host) so Twilio can post the plumber's yes/no answer.
HAVEN_PUBLIC_URL=

# Linear: the facilities ticket is filed for real on approval (linear.app -> Settings -> API).
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# ElevenLabs: HAVEN's voice, first in line (Buds, the plumber script, briefs); Cartesia is second.
# ELEVENLABS_AGENT_ID (a Conversational AI agent in your account) enables the live voice agent.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_AGENT_ID=

# Clerk: roles are decided here, not in the browser. With the secret key set, every role-aware request must
# carry the signed-in user's session token; the role is the user's public_metadata.role
# (resident | ra | maintenance | admin, default resident) and public_metadata.person_id links a roster id.
# Without it the demo runs open and X-Haven-Role picks the role (default admin).
CLERK_SECRET_KEY=
# Optional: comma-separated origins allowed to hold a session (the token's azp), e.g. http://localhost:5173
CLERK_AUTHORIZED_PARTIES=

# Resend: alerts and updates by email (the in-app inbox is the record; email is a copy).
RESEND_API_KEY=
# A sender on a domain verified in Resend. Empty = Resend's test sender, which only reaches the account owner.
RESEND_FROM=
